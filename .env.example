# backend/.env —— 真實值放這（.env 已被 .gitignore 擋，不會進版控）。
# 只列「調度助理」需要的環境變數；PostgreSQL 等其餘設定 config.py 已有預設值。

# ── 調度助理・AgentCore Harness ──
# 不填 → 調度類問題回「暫時無法回應」；填了才會真的呼叫 Bedrock。
# 憑證用「你自己 AWS 帳號」開的 IAM user，權限：
#   bedrock-agentcore:InvokeHarness（或 InvokeAgentRuntime）、
#   bedrock:InvokeModel、bedrock:InvokeModelWithResponseStream
# 部署到 AWS 時改用 IAM role，不需要 KEY。
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ASSISTANT_HARNESS_ARN=arn:aws:bedrock-agentcore:ap-northeast-1:597671487936:harness/imsoft_ubike_agentcore_harness-ZBEN5wmyW5

# ── 選填 ──
# SSE 每段字數（越小越像逐字打字，預設 20）
# ASSISTANT_CHUNK=20
#
# 預設「收齊再送」：整段答案生成完才做數字驗證 → 出糗的數字不會先流到畫面上，
# 代價是使用者要等 2〜4 秒才看到回覆（不是逐字浮現）。
# 開發時想看逐字串流設 =1（此時數字對不上只記 log、不會攔）。
# ASSISTANT_STREAM=1
#
# 除錯：設 =1 → 每次請求把「送給 Harness 的整段 prompt + 資料包 + Nova 原始回覆 +
# 數字驗證 + 最終輸出」寫成 assistant_debug/<時間>_<問題>.txt（已 gitignore）。給路徑則寫到該資料夾。
# ASSISTANT_DEBUG_DUMP=1
#
# 「從哪調車」的站對站直線距離上限（km）；超過就不建議該站、改用調度中心備車。預設 5。
# ASSISTANT_DONOR_MAX_KM=5
